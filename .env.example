# Скопируйте этот файл в .env и заполните. Файл .env в git НЕ попадает.

# Токен бота от @BotFather
BOT_TOKEN=
# Имя бота без @, например travel_planner_bot
BOT_USERNAME=

# Telegram ID через запятую (узнать свой ID: команда /myid в боте)
ADMIN_IDS=
USER_IDS=

# Токен Travelpayouts (цены на авиабилеты): app.travelpayouts.com → Профиль → API token
TRAVELPAYOUTS_TOKEN=

# База данных (для docker-compose можно оставить как есть)
DB_USER=travelbot
DB_PASSWORD=travelbot
